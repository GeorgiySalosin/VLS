<Window x:Class="VLSGame.Match"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        WindowState="Maximized"
        WindowStyle="None">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Viewport3D для отображения панорамы -->
        <Viewport3D x:Name="MainViewport" Grid.Row="0">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="MainCamera" 
                                   Position="0,0,0" 
                                   LookDirection="0,0,1" 
                                   UpDirection="0,1,0"
                                   FieldOfView="90"/>
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <AmbientLight Color="White"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <!-- Прицел поверх всего (T_CrossAIM) -->
        <Image x:Name="AimImage" 
               Source="/content/ui/T_CrossAIM.png" 
               Width="64" 
               Height="64"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Panel.ZIndex="999"
               RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
                <DropShadowEffect ShadowDepth="2" 
                                 BlurRadius="4" 
                                 Opacity="0.5"
                                 Color="Black"/>
            </Image.Effect>
        </Image>

        <Border Grid.Row="1" 
        Background="#AA000000" 
        Padding="15" 
        CornerRadius="0"
        Panel.ZIndex="998">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Отображение цвета -->
                <Border Width="50" Height="50" 
                Background="{Binding CenterColor, RelativeSource={RelativeSource AncestorType=Window}}"
                BorderBrush="White" 
                BorderThickness="2"
                Margin="0,0,15,0"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Цвет в центре:" 
                       Foreground="White" 
                       FontSize="14"/>
                    <TextBlock Text="{Binding CenterColorText, RelativeSource={RelativeSource AncestorType=Window}}" 
                       Foreground="White" 
                       FontSize="16" 
                       FontWeight="Bold"/>
                    <TextBlock Text="{Binding PixelCoordinates, RelativeSource={RelativeSource AncestorType=Window}}" 
                       Foreground="LightGreen" 
                       FontSize="14" 
                       FontWeight="Normal"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Инструкция по управлению -->
        <TextBlock Text="Управление: Мышь - вращение | ESC - выход" 
                   Foreground="White" 
                   Background="#AA000000"
                   Padding="10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="10"
                   Panel.ZIndex="998"/>
    </Grid>
</Window>