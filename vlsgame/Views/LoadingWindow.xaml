<Window x:Class="VLSGame.Views.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VLSGame.Views"
        xmlns:vm="clr-namespace:VLSGame.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:LoadingWindowViewModel}"
        Title="Loading" WindowStartupLocation="CenterOwner"
        Width="400" Height="150" WindowStyle="None" ResizeMode="NoResize"
        >
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="16" Text="Loading game, please wait..." Margin="0,0,0,15"/>
        <ProgressBar Grid.Row="1" Height="25" Value="{Binding ProgressBarValue, Mode=OneWay}" Margin="0,0,0,15"/>
        <TextBlock Grid.Row="2" FontSize="15" Text="{Binding LoadingDescription}" Margin="0,0,0,15"/>
    </Grid>
</Window>
