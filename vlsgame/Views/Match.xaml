<Window x:Class="VLSGame.Views.Match"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VLSGame.ViewModels"
        xmlns:local="clr-namespace:VLSGame.Views" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Title="" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        Background ="Black">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="DebugInfo">
            <Setter Property="Foreground" Value="Yellow"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Viewport3D -->
        <Viewport3D x:Name="MainViewport" Grid.Row="0" >
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="MainCamera"
                  Position="0,0,0"
                  LookDirection="{Binding CameraProperties.LookDirection}"
                  UpDirection="0,1,0"
                  FieldOfView="{Binding CameraProperties.FieldOfView}"
                  NearPlaneDistance = "0.01"/>
            </Viewport3D.Camera>
        </Viewport3D>

        <!-- HUD Panel -->
        <Grid x:Name="HudPanel" Grid.Row="0" 
              Background="Transparent"
              IsHitTestVisible="False">
        </Grid>

        <!-- Debug info -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,256,0,0">
            <TextBlock Text="{Binding PixelCoordinates}" Style="{StaticResource DebugInfo}"/>
            <TextBlock Text="{Binding DistanceText}" Style="{StaticResource DebugInfo}"/>
            <TextBlock Text="{Binding FormattedLookDirection}" Style="{StaticResource DebugInfo}"/>
            <TextBlock Text="{Binding LastBullet}" Style="{StaticResource DebugInfo}"/>
        </StackPanel>
    </Grid>
</Window>