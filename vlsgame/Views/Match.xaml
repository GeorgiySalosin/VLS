<Window x:Class="VLSGame.Match"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        KeyDown="Window_KeyDown"
        WindowState="Maximized"
        WindowStyle="None">

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Viewport3D для 3D контента -->
        <Viewport3D x:Name="MainViewport" Grid.Row="0">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="MainCamera" 
                                   Position="0,0,0" 
                                   LookDirection="0,0,1" 
                                   UpDirection="0,1,0"
                                   FieldOfView="90"/>
            </Viewport3D.Camera>
        </Viewport3D>

        <!-- Панель для HUD элементов -->
        <Grid x:Name="HudPanel" Grid.Row="0" 
              Background="Transparent"
              IsHitTestVisible="False">
        </Grid>

        <!-- Информационная панель -->

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <!-- Отображение цвета -->
                <Border Width="50" Height="50" 
                        Background="{Binding CenterColor}"
                        BorderBrush="White" 
                        BorderThickness="2"
                        Margin="0,0,15,0"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Цвет в центре:" 
                               Foreground="White" 
                               FontSize="14"/>
                    <TextBlock Text="{Binding CenterColorText}" 
                               Foreground="White" 
                               FontSize="16" 
                               FontWeight="Bold"/>
                    <TextBlock Text="{Binding PixelCoordinates}" 
                               Foreground="LightGreen" 
                               FontSize="14"/>
                    <TextBlock Text="{Binding DistanceText}" 
                               Foreground="Yellow" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Инструкция -->
        <TextBlock Text="Управление: Мышь - вращение | ESC - выход" 
                   Foreground="White" 
                   Background="#AA000000"
                   Padding="10"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="10"
                   Panel.ZIndex="998"/>
    </Grid>
</Window>