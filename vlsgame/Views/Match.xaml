<Window x:Class="VLSGame.Match"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown"
        WindowState="Maximized"
        WindowStyle="None">

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Viewport3D -->
        <Viewport3D x:Name="MainViewport" Grid.Row="0">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="MainCamera" 
                                   Position="0,0,0" 
                                   LookDirection="0,0,1" 
                                   UpDirection="0,1,0"
                                   FieldOfView="90"/>
            </Viewport3D.Camera>
        </Viewport3D>

        <!-- HUD Panel -->
        <Grid x:Name="HudPanel" Grid.Row="0" 
              Background="Transparent"
              IsHitTestVisible="False">
        </Grid>

        <!-- Debug info -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,192,0,0">
            <TextBlock Text="{Binding PixelCoordinates}" 
                               Foreground="Yellow" 
                               FontSize="16"
                               FontWeight="Bold"/>
            <TextBlock Text="{Binding DistanceText}" 
                               Foreground="Yellow" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
        </StackPanel>

    </Grid>
</Window>