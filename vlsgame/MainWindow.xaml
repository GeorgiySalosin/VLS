<Window x:Class="VLSGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GAME" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- connection mngmt -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="IP:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="1" x:Name="ServerIpTextBox" Text="192.168.0.106" Margin="0,0,5,0"/>

                    <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="3" x:Name="ServerPortTextBox" Text="8888" Width="60" Margin="0,0,5,0"/>

                    <Button Grid.Column="4" x:Name="ConnectButton" Content="Connect" 
                            Click="ConnectButton_Click" Padding="10,5"/>
                </Grid>

                <TextBlock x:Name="ConnectionStatusText" Text="Disconnected" 
                           Foreground="Red" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!--  -->
        <Border Grid.Row="1" Background="White" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="1" x:Name="LastResponseText" Text="The server has not replied" 
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <!-- Click area -->
        <Border Grid.Row="2" Background="LightGray" CornerRadius="5" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Click in this area:" 
                           Margin="5" FontWeight="Bold"/>

                <Border Grid.Row="1" Background="White" CornerRadius="5" Margin="5"
                        MouseLeftButtonDown="ClickArea_MouseLeftButtonDown">
                </Border>

                <Button x:Name="OpenPanoramaButton" 
                    Content="pano" 
                    FontSize="16" Padding="10"
                    Click="OpenPanoramaButton_Click"/>
            </Grid>
        </Border>

        <!-- msg log -->
        <Border Grid.Row="3" Background="#F0F0F0" Padding="10" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Message log" FontWeight="Bold" Margin="0,0,0,5"/>

                <ScrollViewer Grid.Row="1" MaxHeight="100">
                    <ListBox x:Name="MessagesListBox" Background="Transparent" BorderThickness="0"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>